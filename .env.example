# Docker Compose uses these defaults on this computer.
FRONTEND_PORT=5174
BACKEND_PORT=3001
AI_PROVIDER=local
# To enable Gemini, set AI_PROVIDER=gemini, supply a key and choose a model ID.
GEMINI_API_KEY=
GEMINI_MODEL=
# Set IMPORT_SOURCE=organizers and paste the entire GET link from the guide.
IMPORT_SOURCE=mock
ORGANIZER_API_URL=
# Optional. Set before initializing the database for the first time.
POSTGRES_PASSWORD=cqa-local-demo
