generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  RU
  KZ
  EN
}

enum EvaluationStatus {
  DRAFT
  COMPLETED
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Conversation {
  id           String       @id @default(uuid()) @db.Uuid
  externalId   String       @db.VarChar(200)
  groupId      String       @default("__legacy__") @db.VarChar(200)
  language     Language
  channel      String       @db.VarChar(50)
  audioUrl     String?      @db.Text
  // Array ordered by zero-based turn index: [{ speaker, text, ... }].
  transcript   Json         @db.JsonB
  failures     EvaluationFailure[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  evaluations  Evaluation[]
  applicabilityConfirmations ApplicabilityConfirmation[]

  @@index([language, channel])
  @@unique([groupId, externalId])
  @@index([groupId, createdAt, id])
  @@index([createdAt, id])
}

model Checklist {
  id           String               @id @default(uuid()) @db.Uuid
  key          String               @db.VarChar(100)
  name         String               @db.VarChar(200)
  version      Int
  config       Json                 @default("{}") @db.JsonB
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  criteria     ChecklistCriterion[]
  failures     EvaluationFailure[]
  evaluations  Evaluation[]

  @@unique([key, version])
}

model ChecklistCriterion {
  id           String            @id @default(uuid()) @db.Uuid
  checklistId  String            @db.Uuid
  key          String            @db.VarChar(100)
  name         String            @db.VarChar(200)
  maxPoints    Decimal           @db.Decimal(12, 4)
  config       Json              @default("{}") @db.JsonB
  checklist    Checklist         @relation(fields: [checklistId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  results      CriterionResult[]
  applicabilityConfirmations ApplicabilityConfirmation[]

  @@unique([checklistId, key])
  // Composite reference ensures results belong to the evaluation's checklist.
  @@unique([id, checklistId])
}

model EvaluationFailure {
  conversationId String @db.Uuid
  checklistId    String @db.Uuid
  message        String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  checklist      Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([conversationId, checklistId])
}

model Evaluation {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @db.Uuid
  checklistId    String            @db.Uuid
  status         EvaluationStatus  @default(DRAFT)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)
  provider       String?          @db.VarChar(20)
  model          Json?            @db.JsonB
  transport      String?          @db.VarChar(20)
  score          Json?            @db.JsonB
  aiResponse     Json?            @db.JsonB
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checklist      Checklist         @relation(fields: [checklistId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  results        CriterionResult[]

  @@unique([conversationId, checklistId])
  @@unique([id, checklistId])
  @@index([checklistId])
}

model CriterionResult {
  id           String             @id @default(uuid()) @db.Uuid
  evaluationId String             @db.Uuid
  checklistId  String             @db.Uuid
  criterionId  String             @db.Uuid
  points       Decimal?           @db.Decimal(12, 4)
  isNa         Boolean            @default(false)
  explanation  String             @db.Text
  answer       Json?              @db.JsonB
  checkedRange Json?              @db.JsonB
  naReason     String?            @db.Text
  // [{ turnIndex: 0, quote: "..." }]; turnIndex references Conversation.transcript.
  evidence     Json               @default("[]") @db.JsonB
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  evaluation   Evaluation         @relation(fields: [evaluationId, checklistId], references: [id, checklistId], onDelete: Restrict, onUpdate: Restrict)
  criterion    ChecklistCriterion @relation(fields: [criterionId, checklistId], references: [id, checklistId], onDelete: Restrict, onUpdate: Restrict)
  appeals      Appeal[]

  @@unique([evaluationId, criterionId])
  @@index([criterionId, checklistId])
}

model Appeal {
  id                String          @id @default(uuid()) @db.Uuid
  criterionResultId String          @db.Uuid
  comment           String          @db.Text
  status            AppealStatus    @default(PENDING)
  reviewer          String?         @db.VarChar(200)
  decisionReason    String?         @db.Text
  decision          String?         @db.VarChar(10)
  revisedAnswer     Json?           @db.JsonB
  revisedNaReason   String?         @db.Text
  beforeScore       Json?           @db.JsonB
  afterScore        Json?           @db.JsonB
  revisedPoints     Decimal?        @db.Decimal(12, 4)
  revisedIsNa       Boolean?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  decidedAt         DateTime?       @db.Timestamptz(3)
  criterionResult   CriterionResult @relation(fields: [criterionResultId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([criterionResultId, decidedAt])
}

// Positive, independently verified N/A facts. No public write API or AI writes.
model ApplicabilityConfirmation {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  checklistId    String   @db.Uuid
  criterionKey   String   @db.VarChar(100)
  rule           String   @db.VarChar(50)
  confirmedBy    String   @db.VarChar(200)
  reference      String   @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  criterion      ChecklistCriterion @relation(fields: [checklistId, criterionKey], references: [checklistId, key], onDelete: Restrict, onUpdate: Restrict)

  @@unique([conversationId, checklistId, criterionKey], map: "ApplicabilityConfirmation_target_key")
  @@index([checklistId, criterionKey])
}
