{
  "name": "cqa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conversation Quality Analytics backend MVP",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "test:db": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/database.test.js",
    "test:api": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/api.test.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.js",
    "db:seed:official": "node --env-file-if-exists=.env scripts/seed-official-checklist.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  }
}
