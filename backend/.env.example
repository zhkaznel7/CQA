NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated exact frontend origins. Configure before deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Set a private password locally; never commit .env.
POSTGRES_USER=cqa
POSTGRES_DB=cqa
POSTGRES_PASSWORD=
# Docker Compose builds DATABASE_URL from POSTGRES_* using hostname "db".
# For local Node.js, use your local PostgreSQL credentials and URL-encode them.
DATABASE_URL=postgresql://cqa:CHANGE_ME@127.0.0.1:5432/cqa

# No real organizer URL is assumed. Default import uses synthetic fixtures.
IMPORT_SOURCE=mock
ORGANIZER_API_URL=
# Fixed HTTPS endpoint; Backend sets only the group_id query parameter (default DEV).
# Other organizer-issued groups are selected in POST /api/conversations/import JSON.
ORGANIZER_API_TOKEN=
IMPORT_TIMEOUT_MS=10000
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_RECORDS=500

# Local Node.js can call the team's mock; Compose fixes its own HTTP/mock settings.
AI_MODE=http
AI_BASE_URL=http://localhost:8001
# Compose publishes the mock locally on this port; inside Docker it is ai:8001.
AI_PORT=8001
AI_TIMEOUT_MS=100000
AI_MAX_RESPONSE_BYTES=2097152
# Set mock for an HTTP mock too; real AI is not inferred from HTTP transport.
AI_SERVICE_KIND=mock
AI_MOCK_SCENARIO=success
AI_ALLOW_MOCK_IN_PRODUCTION=false
# Compose explicitly permits its demonstration mock in production mode.
