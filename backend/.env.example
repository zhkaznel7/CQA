# Local Node.js settings. Docker Compose reads the .env in the project root.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://cqa:CHANGE_ME@127.0.0.1:5432/cqa
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set organizers to import from the temporary API in the participant guide.
IMPORT_SOURCE=mock
ORGANIZER_API_URL=
ORGANIZER_API_TOKEN=
IMPORT_MAX_BYTES=2097152

AI_MODE=http
AI_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_KIND=ai
AI_TIMEOUT_MS=100000
