NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated exact frontend origins. Configure before deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Set a private password locally; never commit .env.
POSTGRES_USER=cqa
POSTGRES_DB=cqa
POSTGRES_PASSWORD=
# Docker Compose builds DATABASE_URL from POSTGRES_* using hostname "db".
# For local Node.js, use your local PostgreSQL credentials and URL-encode them.
DATABASE_URL=postgresql://cqa:CHANGE_ME@127.0.0.1:5432/cqa

# No real organizer URL is assumed. Default import uses synthetic fixtures.
IMPORT_SOURCE=mock
ORGANIZER_API_URL=
ORGANIZER_API_TOKEN=
IMPORT_TIMEOUT_MS=10000
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_RECORDS=500
